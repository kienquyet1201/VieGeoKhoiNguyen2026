# Copy this file to .env.local for local development, or configure the same
# variables in the Vercel project settings. Never expose service-role keys in public JS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_current_supabase_anon_or_publishable_key
# If your Supabase dashboard provides an sb_publishable_... key, this name is also supported:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

GEMINI_API_KEY=replace_with_a_new_google_gemini_key
GEMINI_SUPPORT_MODEL=gemini-3.5-flash-lite
